# Settings and key NAMES only. Real values go in .env (gitignored).
# On this machine the keys live in the shared .env one folder up.

# ── Server ────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
BUSINESS_NAME=Kwal-ity Electrical
DEFAULT_COUNTRY_CODE=+61
TIMEZONE=Australia/Sydney
DIGEST_HOUR=17
DEDUPE_WINDOW_HOURS=72
CONFIDENCE_FLOOR=0.7

# ── Claude (uses the logged-in Claude Code CLI; no API key for the demo) ──
CLAUDE_BIN=claude
SORT_MODEL=haiku
DRAFT_MODEL=sonnet
CLAUDE_TIMEOUT_MS=60000

# ── GoHighLevel ───────────────────────────────────────
# Private Integration Token with contacts.readonly + contacts.write ONLY.
# No conversations scopes, so the system cannot send a message even by mistake.
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28

# ── Slack incoming webhooks ───────────────────────────
# Leads go to one channel; failures and the daily report go to another.
# If only the leads webhook is set, alerts go there too.
SLACK_LEADS_WEBHOOK=
SLACK_ALERTS_WEBHOOK=
